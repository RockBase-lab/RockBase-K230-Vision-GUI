# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/

# ──────────────────────────────────────────────
# Virtual environments
# ──────────────────────────────────────────────
.venv/
venv/
env/

# ──────────────────────────────────────────────
# Editors and OS
# ──────────────────────────────────────────────
.vscode/
.DS_Store
Thumbs.db

# ──────────────────────────────────────────────
# Agent collaboration config (local only, never committed)
# ──────────────────────────────────────────────
# copilot-instructions.md and skills/ record how one workstation prefers to
# work; they are not product content and other contributors should not be
# forced onto the same rules.
.github/

# ──────────────────────────────────────────────
# Logs and temporary files
# ──────────────────────────────────────────────
*.log
*.tmp
*.bak

# ──────────────────────────────────────────────
# Training pipeline - datasets (large, regenerable)
# ──────────────────────────────────────────────

# Raw downloaded images (the download script can rebuild them)
train/00_capture/raw_images/

# Split train/val/test sets (generated by split_dataset.py)
train/02_dataset/dataset/

# ──────────────────────────────────────────────
# Training pipeline - files that must stay tracked
# ──────────────────────────────────────────────
# train/00_capture/raw_images/*/cat_export/  <- Label Studio export, hand work
# train/00_capture/*.py / *.bat              <- download scripts
# train/02_dataset/split_dataset.py          <- dataset split script
# train/05_compile/*.py                      <- compile scripts

# ──────────────────────────────────────────────
# Training output (large, tens of MB of weights)
# ──────────────────────────────────────────────
runs/

# ──────────────────────────────────────────────
# Build intermediates (regenerable)
# ──────────────────────────────────────────────
# INT8 quantisation calibration data
train/05_compile/calib_data/
# Compiled kmodels (the ones under models/kmodel/ ship with the repo)
train/05_compile/*.kmodel

# ──────────────────────────────────────────────
# Model files (large binaries)
# ──────────────────────────────────────────────
*.pt
*.onnx
*.kmodel

# Flashed firmware images (hundreds of MB, machine-specific)
*.img

# Keep the kmodels that ship with the repo:
!models/kmodel/*.kmodel

# Large CJK source fonts: the baked subset in factory/gui/assets/fonts/ is what
# ships, the 8MB original stays local. See tools/gen_font.py for the spec.
tools/fontsrc/SourceHanSansCN-Regular.ttf

# Scratch scripts and experiment output
tmp/

# ──────────────────────────────────────────────
# Design notes (local only, never committed)
# ──────────────────────────────────────────────
*_design.md
*设计*.md

tools/_lvfc_master/